# Only the live site is tracked. Build sources, scratch and private working
# folders are excluded locally (see .git/info/exclude on the build machine).

# build sources / scratch at the repo root
/*.js
/*.py
/*.md
/*.json
/*.sh
/*.txt
/*.zip
/*.pdf
!/essays.json
!/lighthouserc.json

# backups and test pages never ship
*.bak-*
*.backup-*
/index-test.html
/index.prerendered.html

# tooling and OS cruft
node_modules/
package.json
package-lock.json
.DS_Store
*.tmp
/index.newlanding.html
